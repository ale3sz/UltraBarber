# ==============================================================================
# ULTRA BARBER STUDIO - CONFIGURACIÓN DE ENTORNO Y PRODUCCIÓN
# ==============================================================================

# Entorno: 'development' o 'production'
NODE_ENV=production

# Puerto del servidor backend Express
PORT=7201

# Clave secreta para firma criptográfica de tokens JWT (HS256)
# REQUERIDO EN PRODUCCIÓN: Generar un string criptográfico aleatorio de al menos 32-64 caracteres.
# Ejemplo en terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplazar_con_clave_secreta_super_segura_de_minimo_32_caracteres_en_produccion

# Orígenes permitidos para CORS (separados por comas sin espacios)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://tudominio.com.ar

# Teléfono de WhatsApp de la barbería (formato internacional con prefijo de país y código de área, ej: 5493413762115)
WHATSAPP_PHONE=5493413762115
